# Copy values into your shell environment; .env is not loaded automatically.
# Optional embeddings; embed/hybrid send text to this configured service.
EMBEDDING_BASE_URL=https://embedding-service.example/v1
EMBEDDING_API_KEY=replace-with-your-secret
EMBEDDING_MODEL=replace-with-provider-model

# Optional generation; --live sends questions and retrieved evidence.
MODEL_BASE_URL=https://chat-service.example/v1
MODEL_API_KEY=replace-with-your-secret
MODEL_NAME=replace-with-provider-model
